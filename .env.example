# Modelo do .env usado NO SERVIDOR, em /var/www/validador_docs_github/.env
# (lido pelos dois servicos via env_file no docker-compose).
# NUNCA faca commit do .env real (ja esta no .gitignore).
# O deploy por rsync PRESERVA o .env existente no servidor (esta na lista de exclude).

# ---- IA ----
GEMINI_API_KEY=

# ---- Banco (RDS / MySQL do portal) ----
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# ---- App ----
NODE_ENV=production
# Token de autenticacao da API do validador (usado pelo portal que embeda a app).
VALIDATOR_API_TOKEN=

# ---- Opcionais ----
# Caminho do modelo YOLO de assinatura dentro do container (volume ./models).
# YOLO_SIGNATURE_MODEL=/app/models/signature.pt
# Chave da OpenAI (apenas se for usar o fluxo de cartao ponto via OpenAI).
# OPENAI_API_KEY=
